# =====================================================================
# Cloudflare Pages — _headers
# التوثيق: https://developers.cloudflare.com/pages/configuration/headers/
# =====================================================================

# ---------- كل الصفحات: هيدرز أمان أساسية ----------
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-XSS-Protection: 1; mode=block

# ---------- ملفات الأصول الثابتة (JS/CSS المبنية عبر Vite بأسماء
#            فيها hash) — كاش طويل جدًا لأن أي تعديل في الملف بيغيّر
#            اسمه تلقائيًا، فمفيش خطر من الكاش القديم ----------
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ---------- الصور والخطوط — كاش طويل نسبيًا مع السماح بالتحديث
#            بعد فترة (لو الملفات مش fingerprinted بالكامل) ----------
/images/*
  Cache-Control: public, max-age=604800

/sprites/*
  Cache-Control: public, max-age=604800

*.woff2
  Cache-Control: public, max-age=31536000, immutable

# ---------- ملفات الأيقونات (favicons) ----------
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-96x96.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/web-app-manifest-192x192.png
  Cache-Control: public, max-age=86400

# ---------- الصفحات نفسها (HTML) — بدون كاش طويل عشان أي تحديث
#            على المحتوى يظهر فورًا للزوار ----------
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# ---------- ملفات SEO ----------
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml
